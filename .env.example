# ─────────────────────────────────────────────
#  AI Job Bot — Environment Variables
# ─────────────────────────────────────────────

# Application
APP_NAME="AI Job Bot"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY="change-this-to-a-long-random-string-in-production"

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://jobbot:jobbot_password@localhost:5432/jobbot_db"

# Redis
REDIS_URL="redis://localhost:6379"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Job APIs (get free keys at adzuna.com/api and rapidapi.com)
ADZUNA_APP_ID="your_adzuna_app_id"
ADZUNA_API_KEY="your_adzuna_api_key"

# Optional: SerpAPI for Google Jobs (serpapi.com)
SERPAPI_KEY=""

# File Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# CORS origins (comma separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
